<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings>
    <add name="TestContext" connectionString="data source=testdb.sqlite;initial catalog=Test;App=EntityFramework;" providerName="System.Data.SQLite.EF6" />
  </connectionStrings>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SQLite.EF6" type="System.Data.SQLite.EF6.SQLiteProviderServices, System.Data.SQLite.EF6" />
      <provider invariantName="System.Data.SQLite" type="System.Data.SQLite.EF6.SQLiteProviderServices, System.Data.SQLite.EF6" />
    </providers>
  </entityFramework>
  <system.data>
    <DbProviderFactories>
      <remove invariant="System.Data.SQLite.EF6" />
      <add name="SQLite Data Provider (Entity Framework 6)" invariant="System.Data.SQLite.EF6" description=".NET Framework Data Provider for SQLite (Entity Framework 6)" type="System.Data.SQLite.EF6.SQLiteProviderFactory, System.Data.SQLite.EF6" />
      <remove invariant="System.Data.SQLite" />
      <add name="SQLite Data Provider" invariant="System.Data.SQLite" description=".NET Framework Data Provider for SQLite" type="System.Data.SQLite.SQLiteFactory, System.Data.SQLite" />
    </DbProviderFactories>
  </system.data>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Resources.Extensions" culture="neutral" publicKeyToken="cc7b13ffcd2ddd51" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Объектив: базовая конфигурация                                       -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Позиция фокуса для пустого короба (дно) в единицах мотора -->
    <add key="lens_focus_home" value="3549" />
    <!-- Домашняя позиция зума -->
    <add key="lens_zoom_home" value="8950" />
    <!-- Домашняя позиция диафрагмы -->
    <add key="lens_iris_home" value="340" />
    <!--
      Интервал калибровки фокуса (FocusInit) в коробах.
        1  = калибровать при каждом коробе
        10 = калибровать каждые 10 коробов (короб 1, 11, 21, ...)
    -->
    <add key="lens_focus_calibration_interval" value="100" />
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Объектив: повторные попытки при ошибках                              -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Количество повторных попыток при ошибках объектива (1-10, по умолчанию: 3) -->
    <add key="lens_retry_count" value="3" />
    <!-- Задержка между повторными попытками в мс (50-2000, по умолчанию: 300) -->
    <add key="lens_retry_delay_ms" value="300" />
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Рабочий процесс короба                                              -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Автоматически начинать следующий короб после успешного завершения -->
    <add key="box_workflow_auto_start" value="true" />
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Подключение к серверу L3                                            -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- URL сервера L3 -->
    <add key="l3_url" value="http://localhost:5124/api/v1" />
    <!-- Логин для подключения к L3 -->
    <add key="l3_login" value="Lanapharm" />
    <!-- Пароль для подключения к L3 -->
    <add key="l3_password" value="NativeTrace" />
    <!-- Токен авторизации L3 -->
    <add key="l3_token" value="test-token-12345" />
    <!-- Идентификатор оборудования в L3 -->
    <add key="l3_equip_id" value="1" />
    <!-- Таймаут подключения к серверу L3 в секундах -->
    <add key="l3_server_timeout" value="6" />
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Принтер                                                             -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Имя принтера в системе -->
    <add key="PRINTER_name" value="TSC TE210" />
    <!-- Количество копий по умолчанию (1-10) -->
    <add key="PRINTER_copies_default" value="1" />
    <!--
      Источник шаблона этикетки:
        "server" = шаблон из заказа L3 (при ошибке автоматически локальный)
        "local"  = всегда локальный шаблон (template.txt)
    -->
    <add key="PRINTER_template_source" value="server" />
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Оборудование                                                        -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Название станции (отображается в заголовке приложения) -->
    <add key="EQUIPMENT_name" value="УСТАНОВКА №АВ-12345" />
    <!-- Application Info -->
    <add key="application_info" value="Версия приложения 2.52, Контакты обслуживающего персонала ХХХ ХХХ ХХХ, дальнейшая информация. Редактируется в конфигурации " />
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- ОТЛАДКА - параметры для разработчиков                               -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Обход принтера: имитирует успешную печать без реального принтера -->
    <add key="debug_printer_bypass" value="false" />
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Служебное (не изменять вручную)                                     -->
    <!-- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <add key="__checksum__" value="aRNJTw6pWrKK03tP" />
  </appSettings>
</configuration>